    {
      "name": "Detectar - imagem do teste",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Resposta no formato do enunciado\", () => {\r\n    const json = pm.response.json();\r\n    pm.expect(json.status).to.eql(\"success\");\r\n    pm.expect(json.detections).to.be.an(\"array\");\r\n    json.detections.forEach(d => {\r\n        pm.expect(d).to.have.keys(\"class_name\", \"confidence\", \"box\");\r\n        pm.expect(d.box).to.have.keys(\"x_min\", \"y_min\", \"x_max\", \"y_max\");\r\n    });\r\n});"
            ]
          }
        }
      ],
