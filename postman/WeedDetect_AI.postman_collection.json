            "exec": [
              "pm.test(\"API online com 12 classes\", () => {\r\n    const json = pm.response.json();\r\n    pm.expect(json.status).to.eql(\"online\");\r\n    pm.expect(json.total_classes).to.eql(12);\r\n});"
